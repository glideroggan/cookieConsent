# Use the official .NET runtime as a parent image
FROM mcr.microsoft.com/dotnet/aspnet:10.0-alpine3.24 AS base
WORKDIR /app
EXPOSE 5220

# Use the .NET SDK for building
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY api.csproj .
RUN dotnet restore
COPY . .
RUN dotnet build -c Release -o /app/build

# Publish the application
FROM build AS publish
RUN dotnet publish -c Release -o /app/publish

# Final stage
FROM base AS final
WORKDIR /app

# Upgrade all Alpine packages for security patches; the zlib minimum (CVE-2026-85091) fails the build if the fix is
# missing and changes this line so a stale cached layer cannot be reused.
RUN apk upgrade --no-cache && apk add --no-cache --upgrade "zlib>=1.3.2-r1"

COPY --from=publish /app/publish .

# The SQLite database (and its -wal/-shm files) is the only thing the app writes, so /app/data is the only directory
# the non-root app user owns; the rest of the filesystem can be mounted read-only. A bind-mounted host data/ folder
# must be owned by the same uid (1654, $APP_UID in the aspnet image).
RUN mkdir -p /app/data && chown $APP_UID:$APP_UID /app/data
ENV ConnectionStrings__DefaultConnection="Data Source=/app/data/consent.db"

USER $APP_UID

ENTRYPOINT ["dotnet", "api.dll"]
