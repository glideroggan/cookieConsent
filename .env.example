# Cookie Consent API Environment Configuration
# Copy this file to .env and update the values for your deployment

# Admin API Key - set a random value (e.g. `openssl rand -base64 32`). Left empty, the API refuses to start outside
# Development, as it does with any example key shown in this repository.
ADMIN_API_KEY=

# Allowed Admin Origins - Domains that can access the admin panel
# Add your admin panel domain(s) here
ADMIN_ORIGIN_1=https://admin.yourdomain.com
ADMIN_ORIGIN_2=http://admin.internal

# Example for local development:
# ADMIN_API_KEY=dev-admin-key-123
# ADMIN_ORIGIN_1=http://localhost:3000
# ADMIN_ORIGIN_2=http://127.0.0.1:3000

# Database Path (if you want to customize)
# DB_PATH=/app/data/consent.db
