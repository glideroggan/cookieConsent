# Cookie Consent API Environment Configuration
# Copy this file to .env (chmod 600) and fill in the values for your deployment

# Admin API Key - required. At least 32 random characters, e.g. the output of `openssl rand -hex 32`.
# The API refuses to start when it is missing, too short or a known placeholder.
ADMIN_API_KEY=

# Allowed admin origins come from api/appsettings.json (the GitHub Pages admin).
# To allow a different admin origin, set AllowedAdminOrigins__0 in the service environment.

# Database Path (if you want to customize)
# DB_PATH=/app/data/consent.db
